<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:OmniConnect.Shared.Enums;assembly=OmniConnect.Shared"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="OmniConnect.Desktop.Views.ChatView"
             x:CompileBindings="False">
    <Grid ColumnDefinitions="260,*,280" Background="#0a0d14">

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- LEFT SIDEBAR - Navigation                                  -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Background="#13161d" Grid.Column="0"
                BorderBrush="#2a2f3a" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <!-- ── User Profile Header ──────────────────────────── -->
                <Border Padding="14,12" BorderBrush="#2a2f3a" BorderThickness="0,0,0,1" Background="#13161d">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <!-- Avatar Circle with Status Dot -->
                        <Grid Width="36" Height="36">
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="#1a1e27" BorderBrush="#2a2f3a" BorderThickness="1.5">
                                <TextBlock Text="{Binding UserDisplayName}"
                                           Foreground="#3b82f6" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Ellipse Width="8" Height="8" Fill="#10b981"
                                     Stroke="#13161d" StrokeThickness="1.5"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,-1,-1"/>
                        </Grid>
                        <!-- Name + Status -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding UserDisplayName}" Foreground="#e4e6eb"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="5" Height="5" Fill="#10b981"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Online"
                                           Foreground="#8b92a5" FontSize="10"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Action Buttons -->
                        <Button Grid.Column="2" Width="28" Height="28" Padding="0"
                                Classes="secondary" FontSize="10" FontWeight="Bold"
                                Foreground="#3b82f6"
                                IsVisible="{Binding IsAdmin}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding ToggleAdminPanelCommand}"
                                ToolTip.Tip="Admin Panel"
                                Content="ADM"/>
                    </Grid>
                </Border>

                <!-- ── Search Bar ────────────────────────────────────── -->
                <Border Padding="12,10" Grid.Row="1">
                    <TextBox Text="{Binding SearchQuery}"
                             PlaceholderText="Search contacts, channels..."
                             Classes="modern"
                             Padding="10,7" FontSize="12"
                             TextChanged="OnSearchTextChanged"/>
                </Border>

                <!-- ── Tab Content Area ──────────────────────────────── -->
                <Grid Grid.Row="2">
                    <TabControl Margin="4,0">
                        <!-- Friends Tab -->
                        <TabItem Header="Friends">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Section Header -->
                                <Grid ColumnDefinitions="*,Auto" Margin="10,8,10,6">
                                    <TextBlock Text="DIRECT MESSAGES" Foreground="#5a5f6f" FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#1a1e27" CornerRadius="10" Padding="6,2" BorderBrush="#2a2f3a" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5" Fill="#10b981" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="#8b92a5" FontSize="9" FontWeight="SemiBold">
                                                <Run Text="{Binding Friends.Count}"/>
                                                <Run Text="online"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ListBox Grid.Row="1" ItemsSource="{Binding Friends}"
                                         SelectedItem="{Binding SelectedFriend}"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="4,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,7" Margin="0,1" CornerRadius="6" Background="Transparent">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <!-- Avatar with Status Dot -->
                                                    <Grid Width="34" Height="34">
                                                        <Border Width="34" Height="34" CornerRadius="17"
                                                                Background="#1a1e27" BorderBrush="#2a2f3a" BorderThickness="1">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#3b82f6" FontSize="12" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Ellipse Width="8" Height="8" Fill="#10b981"
                                                                 Stroke="#13161d" StrokeThickness="1.5"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                 Margin="0,0,-1,-1"/>
                                                    </Grid>

                                                    <!-- Name + Status -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" Foreground="#e4e6eb"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="#8b92a5"
                                                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Call Action Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                Spacing="4" VerticalAlignment="Center">
                                                        <Button Classes="ghost" Padding="5,4" CornerRadius="4"
                                                                ToolTip.Tip="Voice Call"
                                                                Command="{Binding $parent[TabControl].DataContext.StartCallCommand}"
                                                                CommandParameter="{Binding .}">
                                                            <TextBlock Text="📞" FontSize="11"/>
                                                        </Button>
                                                        <Button Classes="ghost" Padding="5,4" CornerRadius="4"
                                                                ToolTip.Tip="Video Call"
                                                                Command="{Binding $parent[TabControl].DataContext.StartVideoCallCommand}"
                                                                CommandParameter="{Binding .}">
                                                            <TextBlock Text="🎥" FontSize="11"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <!-- Internet Hosts Tab -->
                        <TabItem Header="Internet">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Sub-header -->
                                <Grid ColumnDefinitions="*,Auto" Margin="10,8,10,6">
                                    <TextBlock Text="ONLINE HOSTS" Foreground="#5a5f6f" FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#1a1e27" CornerRadius="10" Padding="6,2" BorderBrush="#2a2f3a" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5" Fill="#10b981" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="#8b92a5" FontSize="9" FontWeight="SemiBold">
                                                <Run Text="{Binding InternetHosts.Count}"/>
                                                <Run Text="online"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ListBox Grid.Row="1" ItemsSource="{Binding InternetHosts}"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="4,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,7" Margin="0,1" CornerRadius="6" Background="Transparent">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <!-- Avatar -->
                                                    <Border Width="34" Height="34" CornerRadius="17"
                                                            Background="#1a1e27" BorderBrush="#2a2f3a" BorderThickness="1">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   Foreground="#3b82f6" FontSize="12" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Name + Status -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#e4e6eb"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="#8b92a5"
                                                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <!-- Chat Button -->
                                                    <Button Grid.Column="2" Content="Chat" FontSize="10" FontWeight="SemiBold"
                                                            Padding="8,4" CornerRadius="4"
                                                            Classes="primary"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[TabControl].DataContext.ChatWithInternetHostCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <!-- Devices Tab -->
                        <TabItem Header="Devices">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Sub-header with Radar / Mesh active badge -->
                                <Grid ColumnDefinitions="*,Auto" Margin="10,8,10,6">
                                    <TextBlock Text="LOCAL MESH &amp; LAN" Foreground="#5a5f6f" FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#1a1e27" CornerRadius="10" Padding="6,2" BorderBrush="#2a2f3a" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5" Fill="#10b981" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="#8b92a5" FontSize="9" FontWeight="SemiBold">
                                                <Run Text="{Binding DiscoveredDevices.Count}"/>
                                                <Run Text="active"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ScrollViewer Grid.Row="1" Padding="4,0">
                                    <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,8" Margin="0,2" CornerRadius="6"
                                                        Background="#1a1e27" BorderBrush="#2a2f3a" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <!-- Device Icon Container -->
                                                        <Border Width="30" Height="30" CornerRadius="6"
                                                                Background="#13161d"
                                                                BorderBrush="#2a2f3a" BorderThickness="1">
                                                            <TextBlock Text="💻" FontSize="12"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <!-- Device Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{Binding DeviceName}" Foreground="#e4e6eb"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding DeviceModel}" Foreground="#8b92a5"
                                                                       FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                            <!-- Transport Pill -->
                                                            <Border CornerRadius="3" Padding="4,1" Margin="0,2,0,0"
                                                                    Background="#13161d" BorderBrush="#2a2f3a" BorderThickness="1"
                                                                    HorizontalAlignment="Left">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <Ellipse Width="4" Height="4" Fill="#10b981" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding TransportDetail}" Foreground="#8b92a5"
                                                                               FontSize="8" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                        <!-- Chat Button -->
                                                        <Button Grid.Column="2" Content="Chat" FontSize="10" FontWeight="SemiBold"
                                                                Padding="8,4" CornerRadius="4"
                                                                Classes="primary"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding $parent[TabControl].DataContext.ChatWithDeviceCommand}"
                                                                CommandParameter="{Binding .}"
                                                                IsVisible="{Binding CanChat}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ── Bottom Actions ────────────────────────────────── -->
                <Border Padding="8,8" Grid.Row="3"
                        BorderBrush="#2a2f3a" BorderThickness="0,1,0,0" Background="#13161d">
                    <StackPanel Spacing="4">
                        <!-- AI Chat -->
                        <Button Command="{Binding ToggleAiPanelCommand}"
                                Classes="ghost" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Padding="8,7" FontSize="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="24" Height="24" CornerRadius="6"
                                        Background="#1a1e27" BorderBrush="#2a2f3a" BorderThickness="1">
                                    <TextBlock Text="AI" Foreground="#3b82f6" FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="AI Assistant" Foreground="#e4e6eb"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <!-- Network Graph -->
                        <Button Command="{Binding ToggleNetworkGraphCommand}"
                                Classes="ghost" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Padding="8,7" FontSize="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="24" Height="24" CornerRadius="6"
                                        Background="#1a1e27" BorderBrush="#2a2f3a" BorderThickness="1">
                                    <TextBlock Text="NET" FontSize="8" FontWeight="Bold" Foreground="#10b981"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Network Mesh" Foreground="#8b92a5"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <!-- Profile / Settings -->
                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Padding="8,7" FontSize="12"
                                Command="{Binding OpenProfileCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="24" Height="24" CornerRadius="6"
                                        Background="#1a1e27" BorderBrush="#2a2f3a" BorderThickness="1">
                                    <TextBlock Text="SET" FontSize="8" FontWeight="Bold" Foreground="#8b92a5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Settings" Foreground="#8b92a5"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <!-- Admin Panel -->
                        <Button Command="{Binding ToggleAdminPanelCommand}"
                                Classes="ghost" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Padding="8,7" FontSize="12"
                                IsVisible="{Binding IsAdmin}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="24" Height="24" CornerRadius="6"
                                        Background="#1a1e27" BorderBrush="#2a2f3a" BorderThickness="1">
                                    <TextBlock Text="ADM" FontSize="8"
                                               Foreground="#f59e0b" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Admin Panel" Foreground="#8b92a5"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- CENTER - Chat / Messages Area                              -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Background="#0a0d14">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- ── Channel Header ──────────────────────────────── -->
                <Border Padding="16,12" Background="#13161d"
                        BorderBrush="#2a2f3a" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedChannel.Name}" Foreground="#e4e6eb"
                                       FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="#5a5f6f"
                                       FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <!-- Notification Bell -->
                            <Button Classes="ghost" Padding="8,6"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Command="{Binding ToggleNotificationsCommand}">
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                                    <TextBlock Text="Alerts" VerticalAlignment="Center" FontSize="12" Foreground="#8b92a5"/>
                                    <Border Grid.Column="1" CornerRadius="8" Width="16" Height="16"
                                            Background="#ef4444"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasUnreadNotifications}">
                                        <TextBlock Text="{Binding UnreadNotificationCount}" FontSize="9"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <!-- AI Chat Toggle -->
                            <Button Classes="ghost" FontSize="12" Padding="8,6"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Command="{Binding ToggleAiPanelCommand}"
                                    Foreground="#3b82f6">
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <Border Width="18" Height="18" CornerRadius="4"
                                            Background="#1a1e27">
                                        <TextBlock Text="AI" Foreground="#3b82f6" FontSize="8"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="AI Chat" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Messages List ───────────────────────────────── -->
                <!-- DB-backed messages (normal chat) -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsRegularChatActive}">
                    <ListBox ItemsSource="{Binding Messages}" Background="Transparent"
                             BorderThickness="0" Padding="16,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0" Margin="0,4">
                                    <StackPanel Spacing="4">
                                        <!-- Message Header -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding SenderName}" Foreground="#3b82f6"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SentAt}"
                                                       Foreground="#5a5f6f" FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Message Bubble -->
                                        <Border CornerRadius="8" Padding="12,10" Margin="0,0,40,0"
                                                Background="#13161d"
                                                BorderBrush="#2a2f3a" BorderThickness="1">
                                            <!-- Text Content -->
                                            <TextBlock Text="{Binding Content}" Foreground="#e4e6eb"
                                                       TextWrapping="Wrap" FontSize="13"
                                                       LineHeight="20"/>
                                        </Border>

                                        <!-- File Attachment -->
                                        <Border CornerRadius="8" Padding="12,10" Margin="0,4,40,0"
                                                Background="#1a1e27"
                                                BorderBrush="#2a2f3a" BorderThickness="1"
                                                IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <!-- File Icon -->
                                                <Border CornerRadius="6" Width="38" Height="38"
                                                        Background="#13161d">
                                                    <TextBlock Text="FILE" FontSize="10" FontWeight="Bold"
                                                               Foreground="#8b92a5"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- File Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" Foreground="#e4e6eb"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Foreground="#5a5f6f" FontSize="10">
                                                        <Run Text="{Binding FileSize}"/>
                                                        <Run Text="bytes"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Download Button -->
                                                <Button Grid.Column="2" Content="Download"
                                                        Classes="ghost" FontSize="11" Padding="8,4"
                                                        Foreground="#3b82f6"
                                                        Command="{Binding $parent[ListBox].DataContext.DownloadFileCommand}"
                                                        CommandParameter="{Binding .}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Ephemeral direct-chat messages (LAN/Bluetooth, no DB) -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsDirectChatActive}">
                    <ListBox ItemsSource="{Binding EphemeralMessages}" Background="Transparent"
                             BorderThickness="0" Padding="16,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0" Margin="0,4">
                                    <StackPanel Spacing="4">
                                        <!-- Message Header -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding SenderName}" Foreground="#3b82f6"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SentAt}"
                                                       Foreground="#5a5f6f" FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Message Bubble -->
                                        <Border CornerRadius="8" Padding="12,10" Margin="0,0,40,0"
                                                Background="#13161d"
                                                BorderBrush="#2a2f3a" BorderThickness="1">
                                            <!-- Text Content -->
                                            <TextBlock Text="{Binding Content}" Foreground="#e4e6eb"
                                                       TextWrapping="Wrap" FontSize="13"
                                                       LineHeight="20"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- ── Message Input ────────────────────────────────── -->
                <Border Padding="0" Grid.Row="2"
                        Background="#13161d"
                        BorderBrush="#2a2f3a" BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                        <!-- Upload Progress Bar -->
                        <ProgressBar IsVisible="{Binding IsUploading}"
                                     Value="{Binding UploadProgress}"
                                     Minimum="0" Maximum="100"
                                     Height="4"
                                     Foreground="#3b82f6"
                                     Background="Transparent"
                                     Margin="0"/>
                        <!-- Input Area -->
                        <Border Grid.Row="1" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <!-- Attachment Button -->
                                <Button Width="38" Height="38" Padding="0"
                                        Classes="secondary"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Click="OnUploadFileClick"
                                        FontSize="18" Foreground="#8b92a5">
                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <!-- Message Field -->
                                <TextBox Grid.Column="1" Text="{Binding MessageText}"
                                         PlaceholderText="Type a message..."
                                         Classes="modern"
                                         VerticalAlignment="Center"
                                         Height="38"/>

                                <!-- Send Button -->
                                <Button Grid.Column="2" Width="38" Height="38" Padding="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Command="{Binding SendMessageCommand}"
                                        Classes="primary">
                                    <TextBlock Text="&gt;" FontSize="14" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- RIGHT PANEL - Search Results / AI Chat                     -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="2" Background="#13161d"
                BorderBrush="#2a2f3a" BorderThickness="1,0,0,0">
            <Grid>
                <!-- ── Search Results Panel ─────────────────────────── -->
                <StackPanel Spacing="8" Margin="16,12">
                    <TextBlock Text="Search Results" Foreground="#8b92a5" FontSize="12"
                               FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,8" Margin="0,2" Background="Transparent"
                                        CornerRadius="6">
                                    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="#3b82f6"
                                                ClipToBounds="True">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="White" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#e4e6eb"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Username}" Foreground="#5a5f6f"
                                                       FontSize="10"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="+" Classes="ghost"
                                                Foreground="#3b82f6" FontSize="14" Width="28" Height="28"
                                                Padding="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- ── AI Chat Panel (overlays when open) ───────────── -->
                <Grid IsVisible="{Binding IsAiPanelOpen}"
                      Background="#13161d"
                      RowDefinitions="Auto,*,Auto">
                    <!-- AI Header -->
                    <Border Padding="16,12"
                            BorderBrush="#2a2f3a" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="6"
                                        Background="#1a1e27">
                                    <TextBlock Text="AI" Foreground="#3b82f6" FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="AI Assistant" Foreground="#e4e6eb" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="X"
                                    Classes="ghost" Width="28" Height="28" Padding="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Command="{Binding ToggleAiPanelCommand}"/>
                        </Grid>
                    </Border>

                    <!-- AI Messages & Conversations -->
                    <ScrollViewer Grid.Row="1" Padding="12,8">
                        <StackPanel Spacing="8">
                            <!-- New Conversation Button -->
                            <Button Content="+ New Chat"
                                    Classes="ghost" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Height="32" FontSize="12"
                                    Foreground="#3b82f6"
                                    Command="{Binding AiVm.NewConversationCommand}"
                                    Margin="0,0,0,8"/>

                            <!-- Conversation List -->
                            <ListBox ItemsSource="{Binding AiVm.Conversations}"
                                     SelectedItem="{Binding AiVm.SelectedConversation}"
                                     Background="Transparent" BorderThickness="0"
                                     MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,1" CornerRadius="6"
                                                Background="Transparent"
                                                BorderBrush="#2a2f3a" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel VerticalAlignment="Center" Spacing="0">
                                                    <TextBlock Text="{Binding Title}" Foreground="#e4e6eb"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Foreground="#5a5f6f" FontSize="9">
                                                        <Run Text="{Binding Provider}"/>
                                                        <Run Text="-"/>
                                                        <Run Text="{Binding ModelName}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TokenCount}"
                                                           Foreground="#5a5f6f" FontSize="9"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- AI Messages -->
                            <ItemsControl ItemsSource="{Binding AiVm.Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,8" Margin="0,4" CornerRadius="6"
                                                Background="#1a1e27"
                                                BorderBrush="#2a2f3a" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <!-- Role badge -->
                                                    <Border CornerRadius="4" Padding="6,2"
                                                            Background="#13161d" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Role}" Foreground="#3b82f6"
                                                                   FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp}"
                                                               Foreground="#5a5f6f" FontSize="9"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Content}" Foreground="#e4e6eb"
                                                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           LineHeight="18"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Loading Indicator -->
                            <Border Padding="12,8" Background="#1a1e27" CornerRadius="6"
                                    IsVisible="{Binding AiVm.IsLoading}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="6" Height="6" Fill="#3b82f6"/>
                                    <Ellipse Width="6" Height="6" Fill="#2563eb"/>
                                    <Ellipse Width="6" Height="6" Fill="#3b82f6"/>
                                    <TextBlock Text="Thinking..." Foreground="#5a5f6f" FontSize="11"
                                               FontStyle="Italic" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- AI Input Area -->
                    <Border Grid.Row="2" Padding="12"
                            BorderBrush="#2a2f3a" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="8">
                            <!-- Provider & Model Selectors -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <ComboBox ItemsSource="{Binding AiVm.AvailableProviders}"
                                          SelectedItem="{Binding AiVm.SelectedProvider}"
                                          Height="30" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AiVm.AvailableModels}"
                                          SelectedItem="{Binding AiVm.SelectedModel}"
                                          Height="30" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Ollama Section (visible when Ollama is selected) -->
                            <StackPanel Spacing="8" IsVisible="{Binding AiVm.IsOllamaSelected}">
                                <!-- Local Models List -->
                                <ItemsControl ItemsSource="{Binding AiVm.OllamaLocalModels}"
                                              MaxHeight="100">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,4" Margin="0,1" CornerRadius="4"
                                                    Background="#1a1e27">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding Name}" Foreground="#e4e6eb"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedSize}"
                                                               Foreground="#5a5f6f" FontSize="9"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Search and Download -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding AiVm.OllamaSearchQuery}"
                                             PlaceholderText="Search models..."
                                             Classes="modern"
                                             FontSize="10" Padding="8,6" Height="28"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse" Height="28"
                                            Classes="secondary"
                                            FontSize="10" Padding="8,0"
                                            Foreground="#3b82f6"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Command="{Binding AiVm.BrowseOllamaModelsCommand}"/>
                                </Grid>

                                <!-- Search Results -->
                                <ItemsControl ItemsSource="{Binding AiVm.OllamaSearchResults}"
                                              MaxHeight="120">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,4" Margin="0,1" CornerRadius="4"
                                                    Background="#1a1e27">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#e4e6eb"
                                                                   FontSize="10" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="#5a5f6f"
                                                                   FontSize="9" TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="120"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedSize}"
                                                               Foreground="#5a5f6f" FontSize="9"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="Download" Height="24"
                                                            Classes="ghost"
                                                            FontSize="9" Padding="6,0"
                                                            Foreground="#10b981"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].DataContext.AiVm.DownloadOllamaModelCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Download Status -->
                                <Border Padding="6,4" CornerRadius="4"
                                        Background="#1a1e27"
                                        IsVisible="{Binding AiVm.IsDownloading}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding AiVm.DownloadStatus}" Foreground="#8b92a5"
                                                   FontSize="10"/>
                                        <ProgressBar Value="{Binding AiVm.DownloadProgress}"
                                                     Minimum="0" Maximum="100" Height="4"
                                                     Foreground="#10b981" Background="#13161d"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Message Input -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding AiVm.MessageText}"
                                         PlaceholderText="Ask AI..."
                                         Classes="modern"
                                         FontSize="12" Padding="10,8" Height="34"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Send" Height="34"
                                        Classes="primary" FontSize="11" Padding="12,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Command="{Binding AiVm.SendAiMessageCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>