<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="620"
             x:Class="OmniConnect.Desktop.Views.CallOverlay"
             x:CompileBindings="False"
             IsVisible="{Binding IsCallActive}"
             Background="#80000000">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
        <Border CornerRadius="12" Background="#13161d" Padding="32" MinHeight="480"
                BorderBrush="#2a2f3a" BorderThickness="1">
            <Grid RowDefinitions="*,Auto">
                <StackPanel Spacing="0" HorizontalAlignment="Stretch">

                    <!-- ═══ Avatar & Caller Info ═══ -->
                    <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                        <!-- Large Avatar Circle -->
                        <Border CornerRadius="50" Width="100" Height="100"
                                Background="{StaticResource PrimaryBrush}"
                                HorizontalAlignment="Center" Padding="3">
                            <Border CornerRadius="47" Width="94" Height="94" Background="#13161d">
                                <TextBlock Text="{Binding DisplayInitial}" FontSize="38" Foreground="#e4e6eb"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>

                        <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="#e4e6eb" HorizontalAlignment="Center"/>

                        <TextBlock FontSize="13" Foreground="#8b92a5" HorizontalAlignment="Center">
                            <Run Text="{Binding CallType}"/>
                            <Run Text="Call"/>
                        </TextBlock>

                        <!-- Call Status / Timer -->
                        <TextBlock Text="{Binding CallStatus}" FontSize="14" Foreground="#3b82f6"
                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CallTimerDisplay}" FontSize="32" Foreground="#e4e6eb"
                                   HorizontalAlignment="Center" FontWeight="Light"
                                   LetterSpacing="2"/>
                    </StackPanel>

                    <!-- ═══ Mute / Speaker Controls ═══ -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Spacing="28" Margin="0,20,0,0">
                        <!-- Mute Button -->
                        <Border CornerRadius="24" Width="56" Height="56"
                                Background="#1a1e27"
                                BorderBrush="#2a2f3a" BorderThickness="1"
                                x:Name="MuteBorder">
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding ToggleMuteCommand}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="56" Height="56" CornerRadius="24">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="MuteIcon" Text="Mute" FontSize="11" FontWeight="SemiBold" Foreground="#e4e6eb"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Speaker Button -->
                        <Border CornerRadius="24" Width="56" Height="56"
                                Background="#1a1e27"
                                BorderBrush="#2a2f3a" BorderThickness="1"
                                x:Name="SpeakerBorder">
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding ToggleSpeakerCommand}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="56" Height="56" CornerRadius="24">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="SpeakerIcon" Text="Audio" FontSize="11" FontWeight="SemiBold" Foreground="#e4e6eb"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Answer / Reject (Incoming) ═══ -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Spacing="36" Margin="0,20,0,0"
                                IsVisible="{Binding ShowAnswerReject}">
                        <Border CornerRadius="28" Width="64" Height="64"
                                Background="{StaticResource SuccessBrush}">
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding AnswerCallCommand}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="64" Height="64" CornerRadius="28"
                                    Foreground="White" FontSize="12" FontWeight="SemiBold"
                                    Content="Answer"/>
                        </Border>
                        <Border CornerRadius="28" Width="64" Height="64"
                                Background="{StaticResource DangerBrush}">
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding RejectCallCommand}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="64" Height="64" CornerRadius="28"
                                    Foreground="White" FontSize="12" FontWeight="SemiBold"
                                    Content="Decline"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ End Call Button (Active / Outgoing) ═══ -->
                <Border Grid.Row="1" CornerRadius="24" Height="48"
                        Background="{StaticResource DangerBrush}"
                        Margin="0,24,0,0"
                        IsVisible="{Binding ShowEndCall}">
                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                            Command="{Binding EndCallCommand}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Foreground="White" FontSize="13" FontWeight="SemiBold"
                            Content="End Call"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>