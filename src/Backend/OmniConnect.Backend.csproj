<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\OmniConnect.Shared.csproj" />
  </ItemGroup>

  <!--
    The in-process llama.cpp runtime (native/omni_llama) is a plain shared
    library, not a NuGet package, so it has to be staged beside the backend
    executable for P/Invoke to find it. The build works fine without it (local
    AI simply reports "runtime not installed"); build it first with
    native/build-windows.ps1 to drop the binary into native/dist/<rid>/.
  -->
  <PropertyGroup>
    <OmniLlamaRid Condition="'$(OmniLlamaRid)' == '' AND '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</OmniLlamaRid>
    <OmniLlamaRid Condition="'$(OmniLlamaRid)' == ''">win-x64</OmniLlamaRid>
    <OmniLlamaSourcePath>$(MSBuildThisFileDirectory)..\..\native\dist\$(OmniLlamaRid)\omni_llama.dll</OmniLlamaSourcePath>
  </PropertyGroup>

  <Target Name="CopyOmniLlamaRuntime" AfterTargets="Build"
          Condition="Exists('$(OmniLlamaSourcePath)')">
    <Copy SourceFiles="$(OmniLlamaSourcePath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="omni_llama runtime staged: $(OutDir)omni_llama.dll" />
  </Target>

</Project>
